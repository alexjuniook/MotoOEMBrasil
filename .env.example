# Database — replace the local-only values before starting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-local-secret
POSTGRES_DB=motooem
DATABASE_URL=postgres://postgres:replace-with-a-unique-local-secret@localhost:5432/motooem

# n8n local access — use unique values; never reuse production credentials
N8N_BASIC_AUTH_USER=replace-with-a-local-username
N8N_BASIC_AUTH_PASSWORD=replace-with-a-unique-local-password
N8N_ENCRYPTION_KEY=replace-with-a-random-32-character-or-longer-key

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=

# OpenAI / embeddings (optional; may incur usage charges)
OPENAI_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
